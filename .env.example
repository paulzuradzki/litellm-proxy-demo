# API key for the LLM proxy
LITELLM_API_KEY=sk-your-key-here

# Proxy base URL, including the /v1 path (nginx routes /v1/*)
LITELLM_BASE_URL=https://ai.paulzuradzki.com/v1

# Pi privacy: no telemetry, no startup version check.
# Forwarded into the sandbox container by docker-compose.yml.
PI_TELEMETRY=0
PI_SKIP_VERSION_CHECK=1
